FROM node:20-alpine AS builder
WORKDIR /app

# 1. Copy everything first so we can verify files
COPY . .

# 2. PROOF OF LIFE: This will fail the build if src isn't there
RUN ls -d src || { echo "CRITICAL: src folder not found in build context!"; exit 1; }

# 3. Clean install and build
RUN npm install
RUN npx vite build

# Stage 2: Serve
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]